{
  "schemaVersion": 1,
  "id": "simpleframes",
  "version": "${version}",

  "name": "Simple Frames",
  "description": "Make your item frames invisible with shears, and restore them with leather.",
  "authors": [
    "iSlavok"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/simple-frames",
    "sources": "https://github.com/iSlavok/Simple-Frames",
    "issues": "https://github.com/iSlavok/Simple-Frames/issues"
  },

  "license": "MIT",
  "icon": "assets/simpleframes/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "online.slavok.frames.SimpleFramesMod"
      }
    ]<% if (gui) { %>,
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "online.slavok.frames.client.ModMenuIntegration"
      }
    ]<% } %>
  },
  "mixins": [
    "simpleframes.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.8",
    "minecraft": "${minecraft_dep}",
    "java": ">=${java_level}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*"<% if (gui) { %>,
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"<% } %>
  }
}
